# Только локальная разработка. Создайте .env и задайте собственный пароль.
PAWSPOT_DB_HOST=127.0.0.1
PAWSPOT_DB_PORT=5432
PAWSPOT_DB_NAME=pawspot
PAWSPOT_DB_USER=pawspot
PAWSPOT_DB_PASSWORD=replace-with-local-password
PAWSPOT_DB_CONNECT_TIMEOUT_SECONDS=3
PAWSPOT_PUBLIC_LOCATION_RADIUS_M=200
# Закрытый пилот: Telegram user IDs через запятую.
PAWSPOT_ALLOWED_TELEGRAM_IDS=
PAWSPOT_TELEGRAM_BOT_TOKEN=
PAWSPOT_INTERNAL_SERVICE_TOKEN=
PAWSPOT_CORS_ORIGINS=
PAWSPOT_AUTH_INIT_DATA_MAX_AGE_SECONDS=300
PAWSPOT_AUTH_SESSION_HOURS=12
